DATABASE_URL="file:./dev.db"
SESSION_SECRET="dev-only-change-me-to-32-chars-min"
SESSION_COOKIE_NAME="sn_admin_session"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WHATSAPP_BUSINESS_NUMBER=""
# Optional fallback only — prefer Admin → Settings → WhatsApp number

# OTP — email via Admin → Settings (preferred)
# Or set here: company Gmail + App Password
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="yourshop@gmail.com"
# SMTP_PASS="your-16-char-app-password"
# EMAIL_FROM="yourshop@gmail.com"

# Optional: Resend instead of SMTP
# RESEND_API_KEY=""
# EMAIL_FROM="OTP <otp@yourdomain.com>"
# OTP_EMAIL_WEBHOOK_URL="https://your-server.example/otp-email"

# OTP SMS fallback — AuthKey 2FA
# Docs: https://authkey.io/2fa-api-docs
# 1) Sign up at https://authkey.io
# 2) SMS → Template with {#2fa#} variable → copy SID
# 3) Copy Auth Key from dashboard
AUTHKEY_AUTH_KEY=""
AUTHKEY_SID=""

# Optional fallback: Fast2SMS OTP route
# FAST2SMS_API_KEY=""

# Optional: custom SMS/WhatsApp webhook instead of AuthKey/Fast2SMS
# OTP_WEBHOOK_URL="https://your-server.example/otp"

# Force show Dev OTP on screen even when SMS/email is configured
# OTP_DEBUG=1
